@page "/admin/mail-settings"
@attribute [Authorize(Policy = AuthPolicies.SuperAdminOnly)]
@using MIP.Aws.Application.Configuration
@using MIP.Aws.Application.Features.Reports
@using MIP.Aws.Application.Scheduling
@using MIP.Aws.Domain.Security
@using MIP.Aws.Application.Time
@using Microsoft.AspNetCore.WebUtilities
@inject IMediator Mediator
@inject IUserTimeZone UserTz
@inject ISnackbar Snackbar
@rendermode InteractiveServer

<PageTitle>Mail settings</PageTitle>

<ErrorBoundary>
    <ChildContent>

<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudIcon Icon="@Icons.Material.Filled.Email" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.h4" Style="font-weight:700;">Mail settings</MudText>
        <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Outlined">@_providerLabel</MudChip>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" Disabled="_busy" OnClick="ReloadAsync">Refresh</MudButton>
    </MudStack>

    @if (_status?.DevelopmentSafetyEnabled == true)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
            Development safety is active. All outbound mail is redirected to <strong>@(_status.RedirectAllTo ?? "—")</strong>
            with subject prefix applied.
        </MudAlert>
    }

    <MudGrid Spacing="3">
        <MudItem xs="12" lg="6">
            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-3">Download batch schedule</MudText>
                <MudTextField T="string" Label="Start time (UTC)" @bind-Value="_batchScheduleTimeUtc"
                              Variant="Variant.Outlined"
                              HelperText="@($"24-hour UTC, e.g. 04:30. Bahrain: {_batchLocalTime}.")" />
                <MudSelect T="string" Label="Recurrence" @bind-Value="_batchRecurrence" Variant="Variant.Outlined" Class="mt-2">
                    <MudSelectItem T="string" Value="@("Daily")">Every day</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Weekdays")">Weekdays (Monday–Friday)</MudSelectItem>
                    <MudSelectItem T="string" Value="@("CustomDays")">Selected days</MudSelectItem>
                </MudSelect>
                @if (string.Equals(_batchRecurrence, "CustomDays", StringComparison.OrdinalIgnoreCase))
                {
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-2">
                        @foreach (var day in DownloadBatchSchedule.WeekDays)
                        {
                            <MudCheckBox T="bool" Value="_batchDays.Contains(day.CronDay)"
                                         ValueChanged="@(on => ToggleBatchDay(day.CronDay, on))"
                                         Label="@day.Label" Dense="true" />
                        }
                    </MudStack>
                }
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                    Hangfire job runs <strong>@_batchSummary</strong>. Status email is sent when the batch finishes (and after Execute PDF download task).
                </MudText>
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.h6" Class="mb-3">Download monitor status email</MudText>
                <MudSwitch T="bool" @bind-Value="_statusEmailEnabled" Label="Send daily status email" Color="Color.Primary" />
                <MudTextField T="string" Label="Status email recipient" @bind-Value="_statusEmailRecipient"
                              Variant="Variant.Outlined" Class="mt-2"
                              HelperText="Semicolon-separated recipients for download monitor status email" />
                <MudTextField T="string" Label="Admin intervention recipient" @bind-Value="_adminRecipientEmail"
                              Variant="Variant.Outlined" Class="mt-2"
                              HelperText="Inform Admin mailto links in status emails open a draft to this address (e.g. admin_mip@gfh.com)" />
                <MudSwitch T="bool" @bind-Value="_mailAutomationEnabled" Label="Mail automation enabled" Color="Color.Primary" Class="mt-3" />
                <MudButton Class="mt-3" Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy" OnClick="SaveSchedulerAsync">
                    Save scheduler settings
                </MudButton>
                <MudDivider Class="my-4" />
                <MudText Typo="Typo.h6" Class="mb-3">PDF Download mail</MudText>
                <MudSwitch T="bool" @bind-Value="_pdfDownloadMailEnabled"
                           Label="Send after every fully successful batch" Color="Color.Primary" />
                <MudTextField T="string" Label="Send time (UTC)" @bind-Value="_pdfDownloadMailTimeUtc"
                              Variant="Variant.Outlined" Class="mt-2"
                              HelperText="24-hour UTC, e.g. 06:00. The mail is sent only when the final batch has every PDF." />
                <MudTextField T="string" Label="PDF mail recipients" @bind-Value="_pdfDownloadMailRecipient"
                              Variant="Variant.Outlined" Class="mt-2"
                              HelperText="Semicolon-separated recipients" />
                <MudTextField T="string" Label="PDF mail subject" @bind-Value="_pdfDownloadMailSubject"
                              Variant="Variant.Outlined" Class="mt-2" />
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                    Each row opens its PDF in the browser; its Download button downloads the PDF.
                    Links work without login and expire after 24 hours.
                </MudAlert>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="6">
            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-3">Mail provider</MudText>
                @if (_status is null)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else
                {
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.body2">Provider: <strong>@_providerLabel</strong></MudText>
                        <MudText Typo="Typo.body2">Transport enabled: @(_status.SesEnabled ? "Yes" : "No")</MudText>
                        <MudText Typo="Typo.body2">Sender configured: @(_status.SesSenderConfigured ? "Yes" : "No")</MudText>
                        <MudText Typo="Typo.body2">From: @(_status.FromEmail ?? "—")</MudText>
                        <MudText Typo="Typo.body2">Ready: @(_status.IsReady ? "Yes" : "No")</MudText>
                    </MudStack>
                    @if (!string.IsNullOrWhiteSpace(_status.ConfigurationMessage))
                    {
                        <MudAlert Severity="Severity.Warning" Class="mt-2" Dense="true">@_status.ConfigurationMessage</MudAlert>
                    }
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="6">
            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-3">Development safety</MudText>
                <MudSwitch T="bool" @bind-Value="_developmentSafety" Label="Development safety enabled" Color="Color.Warning" />
                <MudTextField T="string" Label="Redirect all to" @bind-Value="_redirectTo" Variant="Variant.Outlined" Class="mt-2"
                              HelperText="Semicolon-separated addresses for development safety redirect" />
                <MudTextField T="string" Label="Subject prefix" @bind-Value="_subjectPrefix" Variant="Variant.Outlined" Class="mt-2" />
                <MudButton Class="mt-3" Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy" OnClick="SaveSafetyAsync">
                    Save safety settings
                </MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-2">Actions</MudText>
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Send"
                       Disabled="_busy || _status?.IsReady != true" OnClick="SendTestEmailAsync">Send test email</MudButton>
            <MudButton Color="Color.Secondary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.MonitorHeart"
                       Disabled="_busy || _status?.IsReady != true" OnClick="SendStatusEmailAsync">Send status email now</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PictureAsPdf"
                       Disabled="_busy || _status?.IsReady != true || !_pdfDownloadMailEnabled"
                       OnClick="SendPdfDownloadMailAsync">Send PDF Download mail now</MudButton>
        </MudStack>
        @if (_lastTest is not null)
        {
            <MudAlert Severity="@(_lastTest.Success ? Severity.Success : Severity.Error)" Class="mt-3" Dense="true">
                Test @(_lastTest.Success ? "sent" : "failed") via @_lastTest.Provider.
                @if (_lastTest.MessageId is not null) { <text> MessageId: @_lastTest.MessageId</text> }
                @if (_lastTest.EmailLogId is not null) { <text> · EmailLog: @_lastTest.EmailLogId</text> }
                @if (_lastTest.Error is not null) { <text> · @_lastTest.Error</text> }
            </MudAlert>
        }
    </MudPaper>

    <MudPaper Class="pa-4" Outlined="true">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Spacing="2">
            <MudText Typo="Typo.h6">Email logs</MudText>
            <MudSpacer />
            <MudDatePicker Date="_logDate" DateChanged="OnLogDateChanged" Label="Log date" Variant="Variant.Outlined"
                           Margin="Margin.Dense" MaxDate="DateTime.Today" Clearable="true"
                           HelperText="Filter by Bahrain calendar day; clear to show recent" />
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="_busy" OnClick="ReloadLogsAsync">Refresh logs</MudButton>
        </MudStack>
        <MudTable Items="_logs" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>When</MudTh>
                <MudTh>Provider</MudTh>
                <MudTh>To</MudTh>
                <MudTh>Subject</MudTh>
                <MudTh>Status</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@UserTz.Format(context.SentAt ?? context.CreatedAt)</MudTd>
                <MudTd>@context.Provider</MudTd>
                <MudTd>@context.To</MudTd>
                <MudTd>@context.Subject</MudTd>
                <MudTd>@context.Status</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">
                    @if (_logDate is null)
                    {
                        <text>No email logs found.</text>
                    }
                    else
                    {
                        <text>No email logs for @(_logDate.Value.ToString("yyyy-MM-dd")).</text>
                    }
                </MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudStack>

    </ChildContent>
    <ErrorContent Context="ex">
        <MudAlert Severity="Severity.Error" Class="my-4">
            Mail settings failed to load: @ex.Message
            <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true))">
                Reload
            </MudButton>
        </MudAlert>
    </ErrorContent>
</ErrorBoundary>

@inject NavigationManager Navigation

@code {
    private bool _busy;
    private MailConfigStatusDto? _status;
    private bool _developmentSafety = true;
    private string _redirectTo = "avneesh.c@almoayyedcomputers.com;cavneesh18@gmail.com";
    private string _subjectPrefix = "[GFH-MIP-TEST]";
    private bool _statusEmailEnabled = true;
    private string _statusEmailRecipient = "Avneesh.c@almoayyedcomputers.com;cavneesh18@gmail.com";
    private bool _mailAutomationEnabled = true;
    private string _adminRecipientEmail = "admin_mip@gfh.com";
    private string _statusEmailTimeUtc = "05:00";
    private string _statusEmailLocalTime = "08:00";
    private string _batchScheduleTimeUtc = "04:30";
    private string _batchRecurrence = nameof(DownloadBatchRecurrence.Daily);
    private readonly HashSet<int> _batchDays = [];
    private bool _pdfDownloadMailEnabled;
    private string _pdfDownloadMailRecipient = string.Empty;
    private string _pdfDownloadMailSubject = "GFH PDF Download";
    private string _pdfDownloadMailTimeUtc = "06:00";
    private TestEmailResponseDto? _lastTest;
    private IReadOnlyList<EmailLogListItemDto> _logs = [];
    private DateTime? _logDate = DateTime.Today;
    private MailActiveProvider _activeProvider = MailActiveProvider.MicrosoftGraph;

    private string _batchLocalTime => MipDisplayTimeZone.FormatUtcTimeOfDay(_batchScheduleTimeUtc);

    private string _batchSummary => DownloadBatchSchedule.Describe(
        _batchScheduleTimeUtc,
        DownloadBatchSchedule.ParseRecurrence(_batchRecurrence),
        string.Join(',', _batchDays));

    private string _providerLabel => _status?.ActiveProvider switch
    {
        "MicrosoftGraph" => "Microsoft Graph",
        "AwsSes" => "AWS SES",
        "Smtp" => "SMTP",
        null or "" => "—",
        var other => other
    };

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task OnLogDateChanged(DateTime? date)
    {
        _logDate = date;
        await ReloadLogsAsync();
    }

    private async Task ReloadLogsAsync()
    {
        try
        {
            var logDate = _logDate is null ? (DateOnly?)null : DateOnly.FromDateTime(_logDate.Value);
            _logs = await Mediator.Send(new GetRecentEmailLogsQuery(100, logDate));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load email logs: {ex.Message}", Severity.Error);
        }
    }

    private async Task ReloadAsync()
    {
        _busy = true;
        try
        {
            _status = await Mediator.Send(new GetMailConfigStatusQuery());
            var settings = await Mediator.Send(new GetMailSettingsQuery());
            _activeProvider = settings.ActiveProvider;
            if (!string.IsNullOrWhiteSpace(_status.ActiveProvider)
                && Enum.TryParse<MailActiveProvider>(_status.ActiveProvider, true, out var fromStatus))
            {
                _activeProvider = fromStatus;
            }
            _developmentSafety = settings.DevelopmentSafetyEnabled;
            _redirectTo = settings.RedirectAllTo ?? _redirectTo;
            _subjectPrefix = settings.SubjectPrefix ?? _subjectPrefix;
            _statusEmailEnabled = settings.StatusEmailEnabled;
            _statusEmailRecipient = settings.StatusEmailRecipient;
            _mailAutomationEnabled = settings.MailAutomationEnabled;
            _adminRecipientEmail = settings.AdminRecipientEmail;
            _statusEmailTimeUtc = settings.StatusEmailTimeUtc;
            _statusEmailLocalTime = MipDisplayTimeZone.FormatUtcTimeOfDay(settings.StatusEmailTimeUtc);
            _batchScheduleTimeUtc = settings.BatchScheduleTimeUtc;
            _batchRecurrence = settings.BatchRecurrence;
            _batchDays.Clear();
            foreach (var day in DownloadBatchSchedule.ParseDays(settings.BatchRecurrenceDays))
            {
                _batchDays.Add(day);
            }
            _pdfDownloadMailEnabled = settings.PdfDownloadMailEnabled;
            _pdfDownloadMailRecipient = settings.PdfDownloadMailRecipient;
            _pdfDownloadMailSubject = settings.PdfDownloadMailSubject;
            _pdfDownloadMailTimeUtc = settings.PdfDownloadMailTimeUtc;
            await ReloadLogsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load mail settings: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveSafetyAsync()
    {
        _busy = true;
        try
        {
            await Mediator.Send(new UpdateMailSettingsCommand(
                _activeProvider,
                _developmentSafety,
                _redirectTo,
                _subjectPrefix));
            Snackbar.Add("Safety settings saved.", Severity.Success);
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveSchedulerAsync()
    {
        _busy = true;
        try
        {
            await Mediator.Send(new UpdateMailSchedulerSettingsCommand(
                _statusEmailEnabled,
                _statusEmailRecipient,
                _mailAutomationEnabled,
                _adminRecipientEmail,
                _batchScheduleTimeUtc,
                _batchRecurrence,
                string.Join(',', _batchDays),
                _pdfDownloadMailEnabled,
                _pdfDownloadMailRecipient,
                _pdfDownloadMailSubject,
                _pdfDownloadMailTimeUtc));
            Snackbar.Add("Scheduler settings saved. The download batch Hangfire job was updated.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not save scheduler settings: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ToggleBatchDay(int cronDay, bool selected)
    {
        if (selected)
        {
            _batchDays.Add(cronDay);
        }
        else
        {
            _batchDays.Remove(cronDay);
        }
    }

    private async Task SendTestEmailAsync()
    {
        _busy = true;
        try
        {
            _lastTest = await Mediator.Send(new SendTestReportEmailCommand(
                _statusEmailRecipient,
                "GFH MIP AWS — test email",
                "<p>This is a test email from <strong>GFH MIP AWS</strong>.</p>"));
            Snackbar.Add(_lastTest.Success ? "Test email sent." : "Test email failed.", _lastTest.Success ? Severity.Success : Severity.Error);
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SendStatusEmailAsync()
    {
        _busy = true;
        try
        {
            var sent = await Mediator.Send(new SendDownloadMonitorStatusEmailCommand(
                null,
                _statusEmailRecipient,
                BypassThrottle: true));
            Snackbar.Add(
                sent ? "Status email sent." : "Status email was not sent (check settings and logs).",
                sent ? Severity.Success : Severity.Warning);
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SendPdfDownloadMailAsync()
    {
        _busy = true;
        try
        {
            var sent = await Mediator.Send(new SendPdfDownloadMailCommand());
            Snackbar.Add(
                sent
                    ? "PDF Download mail sent."
                    : "PDF Download mail was not sent. Confirm today's batch has succeeded for every source.",
                sent ? Severity.Success : Severity.Warning);
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
