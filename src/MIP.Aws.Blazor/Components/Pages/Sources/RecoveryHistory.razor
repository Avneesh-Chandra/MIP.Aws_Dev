@page "/sources/recovery-history"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AuthPolicies.SourceRecoveryView)]
@using MIP.Aws.Application.Features.Operator
@using MIP.Aws.Application.Features.SourceRecovery
@using MIP.Aws.Blazor.Components.Pages.Operator.Dialogs
@using MIP.Aws.Domain.Enums
@using static MIP.Aws.Application.Features.Operator.DownloadMonitorStatusLabels
@inject IMediator Mediator
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Recovery History — GFH MIP AWS</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Large" Color="Color.Primary" />
        <MudText Typo="Typo.h4" Style="font-weight:700;">Recovery History</MudText>
        <MudSpacer />
        <MudDatePicker Date="_selectedDate" DateChanged="OnDateChanged" Label="Date" Variant="Variant.Outlined"
                       Margin="Margin.Dense" MaxDate="DateTime.Today" Clearable="true" />
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshAsync" Disabled="_loading">
            Refresh
        </MudButton>
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_items.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            @(_selectedDate.HasValue
                ? $"No recovery attempts for {_selectedDate.Value:yyyy-MM-dd}."
                : "No recovery attempts found.")
        </MudAlert>
    }
    else
    {
        <MudTable Items="_items" Dense="true" Hover="true" Bordered="true">
            <HeaderContent>
                <MudTh>Date</MudTh>
                <MudTh>Source</MudTh>
                <MudTh>Failure</MudTh>
                <MudTh>AI suggestion</MudTh>
                <MudTh>Applied by</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Result</MudTh>
                <MudTh>Success %</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@UserTz.Format(context.CreatedAt, "yyyy-MM-dd HH:mm")</MudTd>
                <MudTd>@context.SourceName</MudTd>
                <MudTd>@context.FailureType</MudTd>
                <MudTd>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.body2">@(context.SelectedOptionTitle ?? "—")</MudText>
                        @if (context.SuggestionLastAttemptAt is DateTimeOffset lastAt)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Last tried @UserTz.Format(lastAt, "yyyy-MM-dd HH:mm")
                            </MudText>
                        }
                    </MudStack>
                </MudTd>
                <MudTd>@context.AppliedByLabel</MudTd>
                <MudTd>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudChip T="string" Size="Size.Small" Color="@StatusColor(context)">@FormatStatus(context)</MudChip>
                        @if (ShowsRecoveryDetails(context))
                        {
                            <MudTooltip Text="@RecoveryDetailsTooltip(context)">
                                <MudIconButton Icon="@Icons.Material.Filled.Info"
                                               Size="Size.Small"
                                               Color="@RecoveryDetailsInfoColor(context)"
                                               aria-label="View AI recovery details"
                                               OnClick="@(() => ViewRecoveryDetailsAsync(context))" />
                            </MudTooltip>
                        }
                    </MudStack>
                </MudTd>
                <MudTd>
                    @if (!string.IsNullOrWhiteSpace(context.ResultSummary))
                    {
                        <MudText Typo="Typo.caption">@Truncate(context.ResultSummary, 100)</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Tertiary">—</MudText>
                    }
                </MudTd>
                <MudTd>
                    @if (context.PredictedSuccessPercent is int predicted)
                    {
                        <span>@predicted% → @(FormatActualSuccessPercent(context))</span>
                    }
                    else if (context.ActualSuccessPercent is int actualOnly)
                    {
                        <span>— → @actualOnly%</span>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudStack>

@code {
    private bool _loading = true;
    private DateTime? _selectedDate = DateTime.UtcNow.Date;
    private IReadOnlyList<SourceRecoveryHistoryItemDto> _items = Array.Empty<SourceRecoveryHistoryItemDto>();

    protected override async Task OnInitializedAsync() => await LoadAsync(reconcile: true);

    private Task RefreshAsync() => LoadAsync(reconcile: true);

    private async Task OnDateChanged(DateTime? value)
    {
        _selectedDate = value;
        await LoadAsync(reconcile: false);
    }

    private async Task LoadAsync(bool reconcile = true)
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var date = _selectedDate.HasValue ? DateOnly.FromDateTime(_selectedDate.Value) : (DateOnly?)null;
            _items = await Mediator.Send(new GetSourceRecoveryHistoryQuery(100, date, reconcile));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load history: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private static bool IsAiRecoverySuccess(SourceRecoveryHistoryItemDto item) =>
        ResolveDisplayStatus(item) == SourceRecoveryAttemptStatus.Succeeded;

    private static bool IsAutoAiRecoverySkipped(SourceRecoveryHistoryItemDto item) =>
        item.IsAutomatic
        && (item.SelectedOptionTitle?.StartsWith("Skipped", StringComparison.OrdinalIgnoreCase) == true
            || item.ResultSummary?.Contains("already tried today", StringComparison.OrdinalIgnoreCase) == true
            || item.ResultSummary?.Contains("already tried in this download batch", StringComparison.OrdinalIgnoreCase) == true);

    private static bool IsAutoAiRecoveryFailure(SourceRecoveryHistoryItemDto item) =>
        item.IsAutomatic
        && !IsAutoAiRecoverySkipped(item)
        && ResolveDisplayStatus(item) is SourceRecoveryAttemptStatus.Failed
            or SourceRecoveryAttemptStatus.RolledBack;

    private static bool ShowsRecoveryDetails(SourceRecoveryHistoryItemDto item) =>
        item.IsAutomatic
            ? IsAiRecoverySuccess(item) || IsAutoAiRecoveryFailure(item) || IsAutoAiRecoverySkipped(item)
            : ResolveDisplayStatus(item) is SourceRecoveryAttemptStatus.Succeeded
                or SourceRecoveryAttemptStatus.Failed
                or SourceRecoveryAttemptStatus.RolledBack
                or SourceRecoveryAttemptStatus.RetryEnqueued;

    private static Color RecoveryDetailsInfoColor(SourceRecoveryHistoryItemDto item) =>
        IsAutoAiRecoverySkipped(item)
            ? Color.Warning
            : ResolveDisplayStatus(item) is SourceRecoveryAttemptStatus.Failed
                or SourceRecoveryAttemptStatus.RolledBack
                || IsAutoAiRecoveryFailure(item)
                ? Color.Error
                : Color.Success;

    private static string RecoveryDetailsTooltip(SourceRecoveryHistoryItemDto item) =>
        item.IsAutomatic
            ? (IsAutoAiRecoverySkipped(item)
                ? "View skipped automatic recovery details"
                : IsAutoAiRecoveryFailure(item)
                    ? "View automatic AI recovery attempt details"
                    : "View AI recovery details")
            : "View manual AI recovery details";

    private static string FormatSuccessStatus(SourceRecoveryHistoryItemDto item) =>
        item.IsAutomatic ? SuccessByAutoAiRecovery : SuccessByAiRecovery;

    private async Task ViewAiRecoverySuccessDetailsAsync(SourceRecoveryHistoryItemDto item)
    {
        var parameters = new DialogParameters<OperatorAiRecoverySuccessDialog>
        {
            { x => x.AttemptId, item.AttemptId },
            { x => x.RecoveryDownloadJobId, item.RetryDownloadJobId },
            { x => x.SourceName, item.SourceName }
        };
        await DialogService.ShowAsync<OperatorAiRecoverySuccessDialog>($"AI recovery — {item.SourceName}", parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Large });
    }

    private async Task ViewAutoAiRecoveryFailureDetailsAsync(SourceRecoveryHistoryItemDto item)
    {
        if (item.DownloadJobId is not Guid failedJobId)
        {
            Snackbar.Add("No download job is linked to this automatic recovery attempt.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<OperatorAutoAiRecoveryDetailsDialog>
        {
            { x => x.DownloadJobId, failedJobId },
            { x => x.SourceName, item.SourceName }
        };
        await DialogService.ShowAsync<OperatorAutoAiRecoveryDetailsDialog>(
            $"Automatic AI recovery — {item.SourceName}",
            parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium });
    }

    private Task ViewRecoveryDetailsAsync(SourceRecoveryHistoryItemDto item) =>
        item.IsAutomatic && (IsAutoAiRecoveryFailure(item) || IsAutoAiRecoverySkipped(item))
            ? ViewAutoAiRecoveryFailureDetailsAsync(item)
            : ViewAiRecoverySuccessDetailsAsync(item);

    private static SourceRecoveryAttemptStatus ResolveDisplayStatus(SourceRecoveryHistoryItemDto item)
    {
        if (item.Status == SourceRecoveryAttemptStatus.RetryEnqueued)
        {
            return item.ActualSuccessPercent switch
            {
                100 => SourceRecoveryAttemptStatus.Succeeded,
                0 => SourceRecoveryAttemptStatus.Failed,
                _ => item.Status
            };
        }

        return item.Status;
    }

    private static string FormatStatus(SourceRecoveryHistoryItemDto item)
    {
        var status = ResolveDisplayStatus(item);
        return status switch
        {
            SourceRecoveryAttemptStatus.Succeeded => FormatSuccessStatus(item),
            SourceRecoveryAttemptStatus.Failed or SourceRecoveryAttemptStatus.RolledBack when item.IsAutomatic
                => FailedAfterAutoAiRecovery,
            SourceRecoveryAttemptStatus.Failed => "Failed",
            _ => System.Text.RegularExpressions.Regex.Replace(status.ToString(), "([a-z])([A-Z])", "$1 $2")
        };
    }

    private static Color StatusColor(SourceRecoveryHistoryItemDto item)
    {
        if (IsAutoAiRecoveryFailure(item))
        {
            return Color.Error;
        }

        return ResolveDisplayStatus(item) switch
        {
            SourceRecoveryAttemptStatus.Succeeded => Color.Success,
            SourceRecoveryAttemptStatus.Failed or SourceRecoveryAttemptStatus.RolledBack => Color.Error,
            SourceRecoveryAttemptStatus.PendingAdminApproval => Color.Warning,
            _ => Color.Info
        };
    }

    private static string FormatActualSuccessPercent(SourceRecoveryHistoryItemDto item) =>
        item.ActualSuccessPercent switch
        {
            int actual => $"{actual}%",
            null when ResolveDisplayStatus(item) == SourceRecoveryAttemptStatus.RetryEnqueued => "pending",
            _ => "—"
        };

    private static string Truncate(string text, int max) =>
        text.Length <= max ? text : text[..max] + "…";
}
