{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=MIPAws;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "Hangfire": "Server=(localdb)\\mssqllocaldb;Database=MIPAws_Hangfire;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "SigningKey": "MIPAws-Local-Dev-Signing-Key-32chars-min!!"
  },
  "Storage": {
    "LocalRoot": "./storage"
  },
  "Ai": {
    "Provider": "AwsBedrock",
    "Enabled": true,
    "MockMode": false
  },
  "Aws": {
    "Region": "eu-north-1",
    "Profile": "mip-dev",
    "Bedrock": {
      "Enabled": true,
      "Region": "eu-north-1",
      "ModelId": "amazon.nova-lite-v1:0",
      "MaxTokens": 1200,
      "Temperature": 0.2,
      "TopP": 0.9,
      "TimeoutSeconds": 60
    }
  },
  "AiSourceRecovery": {
    "Enabled": true
  },
  "PdfEditionScheduler": {
    "StatusEmailRecipient": "ops@your-domain.example",
    "AdminPortalUrl": "http://localhost:5196"
  },
  "MailAutomation": {
    "Enabled": false
  },
  "Email": {
    "Provider": "MicrosoftGraph",
    "FromEmail": "gfhnews@gfh.com",
    "FromDisplayName": "GFH News"
  },
  "MicrosoftGraph": {
    "Enabled": true,
    "TenantId": "<entra-tenant-id>",
    "ClientId": "<entra-app-client-id>",
    "ClientSecret": "<entra-client-secret>",
    "SenderMailbox": "gfhnews@gfh.com",
    "SenderDisplayName": "GFH News",
    "SaveToSentItems": true
  },
  "Mail": {
    "ActiveProvider": "MicrosoftGraph",
    "DevelopmentSafetyEnabled": true,
    "RedirectAllTo": "avneesh.c@almoayyedcomputers.com",
    "SubjectPrefix": "[GFH-MIP-LOCAL]",
    "AllowedDomains": [ "almoayyedcomputers.com", "gfh.com", "gmail.com" ]
  },
  "AutoAiDownloadRecovery": {
    "Enabled": true
  },
  "IdentitySeed": {
    "SeedDevelopmentRoleUsers": true,
    "DefaultAdminPassword": "CHANGE_ME",
    "DevelopmentUsers": []
  },
  "NewspaperCatalog": {
    "SeedOnStartup": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  }
}
